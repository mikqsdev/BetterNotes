    "Conferma ancora una volta. Potrai recuperare “%@” dal Cestino entro %lld giorni, poi verrà eliminata per sempre." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please confirm once more. You can recover “%1$@” from the Trash within %2$lld days, after which it will be deleted forever."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conferma ancora una volta. Potrai recuperare “%@” dal Cestino entro %lld giorni, poi verrà eliminata per sempre."
          }
        }
      }
    },
    "Conferma ancora una volta. Potrai recuperarle dal Cestino entro %lld giorni, poi verranno eliminate per sempre." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please confirm once more. You can recover them from the Trash within %lld days, after which they will be deleted forever."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conferma ancora una volta. Potrai recuperarle dal Cestino entro %lld giorni, poi verranno eliminate per sempre."
          }
        }
      }
    },
